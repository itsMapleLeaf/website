---
import "@fontsource/fira-sans-condensed/latin-300.css"
import "@fontsource/fira-sans/latin-400.css"
import { Image } from "astro:assets"
import * as SimpleIcons from "simple-icons-astro"
import leaf from "../assets/white-leaf.png"
import { Dots } from "../components/dots.tsx"
import ExternalLink from "../components/external-link.astro"
import { Likes } from "../components/likes.tsx"
import ProjectList from "../components/project-list.astro"
import SocialLink from "../components/social-link.astro"
import { linkStyle } from "../styles/common.ts"

const email = "mapleleafdev@proton.me"
---

<!doctype html>
<html lang="en" class="bg-orange-900 text-orange-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="a website for a nerd who does web coding"
    />
    <link rel="icon" href="/favicon.png" />
    <title>MapleLeaf</title>
    {
      import.meta.env.DEV ? null : (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="2c51dc8b-c17a-4718-93d0-7ab4011a86ac"
        />
      )
    }
    <style>
      ::selection {
        @apply bg-black bg-opacity-50;
      }

      :focus {
        outline: none;
      }

      :focus-visible {
        @apply ring-2 ring-orange-300;
      }
    </style>
  </head>

  <body
    class="flex flex-col px-4 py-16 text-center sm:px-16 sm:py-12 sm:text-left"
  >
    <main class="flex flex-col items-center mb-6 gap-4 sm:items-start">
      <h1 class="font-condensed text-6xl">
        <span class="text-5xl opacity-60">hi, i'm</span> MapleLeaf
        <Image
          src={leaf}
          alt=""
          class="relative top-px inline-block h-[1em] w-[1em] align-text-top opacity-50"
        />
      </h1>
      <section class="flex flex-col text-lg">
        <p>game dev • web dev • music prod • creative writing</p>
        <p>neurodivergent (ADHD) • queer (he/they)</p>
        <p>lover of anime, rhythm games, EDM, and cute things ✨</p>
      </section>
      <!-- <Likes client:idle /> -->
    </main>

    <section class="flex justify-center gap-3 sm:justify-start mb-3">
      <h2 class="sr-only">Social links</h2>
      <SocialLink href="https://github.com/itsMapleLeaf" title="GitHub">
        <SimpleIcons.Github />
      </SocialLink>
      <SocialLink href="https://itsmapleleaf.itch.io" title="itch.io">
        <SimpleIcons.Itchdotio />
      </SocialLink>
      <SocialLink href="https://twitter.com/heyImMapleLeaf" title="X / Twitter">
        <SimpleIcons.X />
      </SocialLink>
      <SocialLink href="https://twitch.tv/imMapleLeaf" title="Twitch">
        <SimpleIcons.Twitch />
      </SocialLink>
      <SocialLink href="https://soundcloud.com/itsmapleleaf" title="SoundCloud">
        <SimpleIcons.Soundcloud />
      </SocialLink>
      <SocialLink href="https://bsky.app/profile/mapleleaf.dev" title="Bluesky">
        <SimpleIcons.Bluesky />
      </SocialLink>
    </section>

    <section class="leading-tight">
      <h2 class="sr-only">Contact & source</h2>
      <address class="grid gap-1 not-italic">
        <p>
          <span class="opacity-75">contact:</span>{" "}
          <ExternalLink
            class={linkStyle}
            href={`mailto:${email}`}
            target="_blank"
          >
            {email}
          </ExternalLink>
        </p>
        <p>
          <ExternalLink
            class={linkStyle}
            href="https://github.com/itsMapleLeaf/website"
            target="_blank"
          >
            view website source
          </ExternalLink>
        </p>
      </address>
    </section>

    <section class="mt-8">
      <h2 class="sr-only">projects</h2>
      <ProjectList />
    </section>

    <Dots client:idle />
  </body>
</html>
